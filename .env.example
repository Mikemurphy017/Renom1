# Copy this file to .env.local (same folder as package.json), fill in your keys,
# then restart the app (stop `npm run dev` and start it again).
# .env.local is git-ignored, so your keys never leave your machine.

# ── Claude: writes ideas, scripts and captions ────────────────────────────
# Create a key at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── Buffer: scheduling and publishing ─────────────────────────────────────
# Use a PERSONAL API key from https://publish.buffer.com/settings/api
# (not a key from the "App clients" tab)
BUFFER_API_KEY=
# Optional: which Buffer organization to use (defaults to your first one)
BUFFER_ORGANIZATION_ID=
# BUFFER_API_URL=https://api.buffer.com

# ── Captions / Mirage: video processing ───────────────────────────────────
# Stays on the offline "mock" processor until the Mirage endpoints are verified.
MIRAGE_API_KEY=
# VIDEO_PROCESSOR=mock
# MIRAGE_VERIFIED=1

# ── White label (optional) ────────────────────────────────────────────────
# NEXT_PUBLIC_BRAND_NAME=Renom
# NEXT_PUBLIC_BRAND_PRIMARY=#B08D57

# Storage bucket for videos, headshots and covers (Railway bucket Credentials, S3, R2…).
# Without these, files go to .data/ and are lost when a container is replaced.
BUCKET=
ENDPOINT=
REGION=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# STORAGE_PATH_STYLE=1
